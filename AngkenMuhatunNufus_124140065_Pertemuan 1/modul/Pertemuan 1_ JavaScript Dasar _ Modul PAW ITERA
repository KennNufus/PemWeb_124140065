<span class="token punctuation">}</span>

console<span class="token punctuation">.</span><span class="token function">log</span><span class="token punctuation">(</span><span class="token string">"Hari ini adalah: "</span> <span class="token operator">+</span> namaHari<span class="token punctuation">)</span><span class="token punctuation">;</span>

